{
  "openapi": "3.1.0",
  "info": {
    "title": "Dermatolog Pro Self-hosted API",
    "version": "4L-Q4-body-atlas-geometry",
    "summary": "Self-hosted visit writes with versioned body-atlas geometry validation",
    "description": "RBAC-protected doctor visit writes. Body-map lesion creation stores a registered region, projection, relative coordinates and server-derived atlas hashes; it requires Idempotency-Key. The backend derives the patient profile at visit time and rejects source/profile/point mismatches. Placement correction uses expectedPlacementRevision. Archive remains a soft delete. Only system_admin and doctor roles may write."
  },
  "servers": [{ "url": "http://localhost:8080", "description": "Self-hosted reverse proxy" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/v1/visits/{visitId}": {
      "patch": {
        "operationId": "updateVisit",
        "summary": "Update visit status, chief complaint, started_at",
        "parameters": [
          { "name": "visitId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VisitPatchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Visit updated" },
          "400": { "description": "Invalid JSON" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Forbidden by RBAC clinic scope" },
          "404": { "description": "Visit not found in scope" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/visits/{visitId}/lesions": {
      "post": {
        "operationId": "createLesion",
        "summary": "Create a lesion attached to a visit",
        "parameters": [
          { "name": "visitId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "Idempotency-Key", "in": "header", "required": false, "description": "Required when bodyMap is present; 16-128 safe characters.", "schema": { "type": "string", "minLength": 16, "maxLength": 128 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LesionCreateRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Lesion created" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Forbidden by RBAC" },
          "404": { "description": "Visit not found in scope" },
          "409": { "description": "Idempotency key reused with another payload" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/lesions/{lesionId}": {
      "patch": {
        "operationId": "updateLesion",
        "summary": "Update lesion fields",
        "parameters": [
          { "name": "lesionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LesionPatchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Lesion updated" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Forbidden by RBAC" },
          "404": { "description": "Lesion not found in scope" },
          "409": { "description": "Placement revision conflict; reload before correction" },
          "422": { "description": "Validation error" }
        }
      },
      "delete": {
        "operationId": "archiveLesion",
        "summary": "Soft-archive lesion (sets deleted_at)",
        "parameters": [
          { "name": "lesionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Lesion archived" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Forbidden by RBAC" },
          "404": { "description": "Lesion not found in scope" }
        }
      }
    },
    "/api/v1/visits/{visitId}/report": {
      "patch": {
        "operationId": "updateReport",
        "summary": "Upsert visit report (physician + patient-safe text)",
        "parameters": [
          { "name": "visitId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReportPatchRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Report saved" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Forbidden by RBAC" },
          "404": { "description": "Visit not found in scope" },
          "422": { "description": "Validation error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "VisitPatchRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["draft", "in_progress", "signed", "cancelled"] },
          "chiefComplaint": { "type": "string", "nullable": true },
          "startedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "LesionCreateRequest": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "bodyZone": { "type": "string", "nullable": true },
          "bodySurface": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["active", "monitoring", "removed", "archived"] },
          "riskLevel": { "type": "string", "enum": ["low", "moderate", "high", "urgent"], "nullable": true }
          ,"bodyMap": { "$ref": "#/components/schemas/BodyMapPlacementRequest" }
        }
      },
      "LesionPatchRequest": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "bodyZone": { "type": "string", "nullable": true },
          "bodySurface": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["active", "monitoring", "removed", "archived"] },
          "riskLevel": { "type": "string", "enum": ["low", "moderate", "high", "urgent"], "nullable": true }
          ,"bodyMap": { "$ref": "#/components/schemas/BodyMapPlacementRequest" }
          ,"expectedPlacementRevision": { "type": "integer", "minimum": 0, "description": "Required when bodyMap is changed; 0 establishes a placement for a historical lesion." }
        }
      },
      "BodyMapPlacementRequest": {
        "type": "object",
        "required": ["atlasSource", "atlasProfileId", "view", "x", "y", "regionId"],
        "properties": {
          "atlasSource": { "type": "string", "enum": ["makehuman-cc0", "daz-hires-local"], "description": "Client atlas package; must match the backend-configured pinned package." },
          "atlasProfileId": { "type": "string", "description": "Stable age/sex profile id derived from the patient and visit reference time." },
          "view": { "type": "string", "enum": ["front", "back", "left", "right", "scalp"] },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "regionId": { "type": "string", "description": "Registered id from the versioned clinical body atlas manifest." },
          "detailId": { "type": "string", "enum": ["digit-1", "digit-2", "digit-3", "digit-4", "digit-5"], "nullable": true }
        }
      },
      "ReportPatchRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["draft", "ready", "signed", "sent"] },
          "physicianText": { "type": "string", "nullable": true },
          "patientSafeText": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
